# Salin menjadi .env untuk menjalankan di komputer sendiri. Di Render, isi lewat menu Environment.

# Connection string dari Neon (Dashboard > Connect), termasuk ?sslmode=require
DATABASE_URL=postgresql://user:sandi@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Kunci acak yang panjang untuk menandatangani sesi login. Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-kunci-acak-yang-panjang

# Alamat frontend di Vercel (boleh lebih dari satu, pisahkan dengan koma). Hanya alamat ini yang boleh memanggil API.
FRONTEND_URL=https://simpuk.vercel.app

# Sandi awal untuk akun baru dan saat sandi direset. Minimal 8 karakter. Tiap anggota wajib menggantinya saat pertama masuk.
SANDI_AWAL=ganti-sandi-awal

# Akun Sekretaris (admin) pertama. Hanya dipakai saat belum ada admin di database.
ADMIN_NIK=20180915
ADMIN_NAMA=Nama Sekretaris

# Opsional: pengeluaran kas mulai nominal ini menunggu validasi Ketua (bawaan 500000).
# BATAS_VALIDASI=500000
